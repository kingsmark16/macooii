{
  "manifest_version": 3,
  "name": "Read with Macooii",
  "version": "0.4.0",
  "description": "Read the Facebook tab you choose and review it locally in Macooii.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Read with Macooii"
  }
}